+/* ti-pet patch (patches/ti-pet-sdk-windows-present.patch): diagnostics.
+ * Under TI_PET_DEBUG=1 the host writes "ti-pet: sdk: ..." lines straight
+ * to the inherited stderr handle (ti-pet's smoke reads them from its log):
+ * which present path each transparent window took, and every 10 s per
+ * canvas how many frame events, presents, layered updates and child
+ * WM_PAINTs happened. Unset (Electron spawns the pet with stdio ignored)
+ * it costs one cached flag check. */
+static bool tiPetDebug() {
+    static const bool enabled = [] {
+        char value[8] = {};
+        const DWORD len = GetEnvironmentVariableA("TI_PET_DEBUG", value, sizeof(value));
+        return len == 1 && value[0] == '1';
+    }();
+    return enabled;
+}
+
+static void tiPetLog(const char *format, ...) {
+    if (!tiPetDebug()) return;
+    char line[512];
+    va_list args;
+    va_start(args, format);
+    int len = vsnprintf(line, sizeof(line) - 1, format, args);
+    va_end(args);
+    if (len < 0) return;
+    if (len > (int)sizeof(line) - 2) len = (int)sizeof(line) - 2;
+    line[len++] = '\n';
+    HANDLE err = GetStdHandle(STD_ERROR_HANDLE);
+    if (!err || err == INVALID_HANDLE_VALUE) return;
+    DWORD written = 0;
+    WriteFile(err, line, (DWORD)len, &written, nullptr);
+}
+
+static void tiPetSurfaceStats(NativeView &view) {
+    if (!tiPetDebug()) return;
+    const ULONGLONG now = GetTickCount64();
+    if (view.tp_logged_ms == 0) view.tp_logged_ms = now;
+    if (now - view.tp_logged_ms < 10000) return;
+    tiPetLog("ti-pet: sdk: surface %s window %u: %u frame events, %u presents, %u layered updates (%u failed), %u child paints in %u ms",
+        view.label.c_str(), (unsigned)view.window_id, view.tp_emits, view.tp_presents, view.tp_layered_ok,
+        view.tp_layered_failed, view.tp_paints, (unsigned)(now - view.tp_logged_ms));
+    view.tp_emits = 0;
+    view.tp_presents = 0;
+    view.tp_layered_ok = 0;
+    view.tp_layered_failed = 0;
+    view.tp_paints = 0;
+    view.tp_logged_ms = now;
+}
