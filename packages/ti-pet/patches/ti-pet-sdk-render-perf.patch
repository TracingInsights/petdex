+    if (changed && host->frame_fast_ticks < NATIVE_SDK_FRAME_TICK_BOOST) host->frame_fast_ticks = NATIVE_SDK_FRAME_TICK_BOOST;
+    if (host->frame_fast_ticks > 0 && --host->frame_fast_ticks == 0 && !host->did_shutdown) {
