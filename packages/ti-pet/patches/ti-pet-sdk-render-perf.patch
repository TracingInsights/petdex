+/* ti-pet patch: the tick pumps FRAME and polls window allocations; at
+ * 16 ms it was ~60 wakeups a second for an app whose frames are driven
+ * by its gpu surface. It runs fast for a while after startup and after
+ * any window is created, resized or reports a new allocation (GTK
+ * settles an allocation over a few frames), and at 100 ms otherwise. */
+#define NATIVE_SDK_FRAME_TICK_FAST_MS 16
+#define NATIVE_SDK_FRAME_TICK_IDLE_MS 100
+#define NATIVE_SDK_FRAME_TICK_BOOST 60
+static gboolean native_sdk_frame_tick(gpointer data);
+
+static void native_sdk_frame_tick_arm(native_sdk_gtk_host_t *host, guint interval_ms) {
+    if (host->frame_timer) g_source_remove(host->frame_timer);
+    host->frame_tick_ms = interval_ms;
+    host->frame_timer = g_timeout_add(interval_ms, native_sdk_frame_tick, host);
+}
+
+static void native_sdk_frame_tick_boost(native_sdk_gtk_host_t *host, int ticks) {
+    if (!host || host->did_shutdown || !host->did_startup) return;
+    if (host->frame_fast_ticks < ticks) host->frame_fast_ticks = ticks;
+    if (host->frame_tick_ms != NATIVE_SDK_FRAME_TICK_FAST_MS) native_sdk_frame_tick_arm(host, NATIVE_SDK_FRAME_TICK_FAST_MS);
+}
