+/* ti-pet patch: window move / resize for X11 (incl. XWayland), the GTK
+ * half of the AppKit/Win32 moveWindow + resizeWindow verbs. Wayland gives
+ * a client no positioning, so there both report failure and apps fall
+ * back to compositor drags. Coordinates are logical (device px / scale). */
+#if NATIVE_SDK_HAS_X11
+static int native_sdk_x11_window(native_sdk_gtk_window_t *win, Display **out_display, Window *out_xid, int *out_scale) {
+    if (!win || !win->gtk_window) return 0;
+    GdkSurface *surface = gtk_native_get_surface(GTK_NATIVE(win->gtk_window));
+    if (!surface || !GDK_IS_X11_SURFACE(surface)) return 0;
+    GdkDisplay *display = gdk_surface_get_display(surface);
+    if (!display || !GDK_IS_X11_DISPLAY(display)) return 0;
+    *out_display = GDK_DISPLAY_XDISPLAY(display);
+    *out_xid = GDK_SURFACE_XID(surface);
+    *out_scale = gdk_surface_get_scale_factor(surface);
+    if (*out_scale < 1) *out_scale = 1;
+    return *out_display != NULL && *out_xid != None;
+}
+
+static void native_sdk_x11_origin(Display *xdisplay, Window xid, int *x, int *y) {
+    Window child = None;
+    *x = 0;
+    *y = 0;
+    XTranslateCoordinates(xdisplay, xid, DefaultRootWindow(xdisplay), 0, 0, x, y, &child);
+}
+#endif
+
+int native_sdk_gtk_move_window(native_sdk_gtk_host_t *host, uint64_t window_id, double dx, double dy, int clamp,
+                               double *out_x, double *out_y, int *out_hit_x, int *out_hit_y, int *out_primary,
+                               double *out_cursor_x, double *out_cursor_y) {
+#if NATIVE_SDK_HAS_X11
+    native_sdk_gtk_window_t *win = native_sdk_find_window(host, window_id);
+    Display *xdisplay = NULL;
+    Window xid = None;
+    int scale = 1;
+    if (!native_sdk_x11_window(win, &xdisplay, &xid, &scale)) return 0;
+    int x = 0, y = 0;
+    native_sdk_x11_origin(xdisplay, xid, &x, &y);
+    *out_hit_x = 0;
+    *out_hit_y = 0;
+    if (dx != 0 || dy != 0) {
+        int nx = x + (int)(dx * scale + (dx < 0 ? -0.5 : 0.5));
+        int ny = y + (int)(dy * scale + (dy < 0 ? -0.5 : 0.5));
+        if (clamp) {
+            int w = gtk_widget_get_width(GTK_WIDGET(win->gtk_window)) * scale;
+            int h = gtk_widget_get_height(GTK_WIDGET(win->gtk_window)) * scale;
+            int sw = DisplayWidth(xdisplay, DefaultScreen(xdisplay));
+            int sh = DisplayHeight(xdisplay, DefaultScreen(xdisplay));
+            if (nx < 0) { nx = 0; *out_hit_x = 1; }
+            if (ny < 0) { ny = 0; *out_hit_y = 1; }
+            if (nx + w > sw) { nx = sw - w; *out_hit_x = 1; }
+            if (ny + h > sh) { ny = sh - h; *out_hit_y = 1; }
+        }
+        XMoveWindow(xdisplay, xid, nx, ny);
+        XFlush(xdisplay);
+        x = nx;
+        y = ny;
+    }
+    Window root_ret = None, child_ret = None;
+    int root_x = 0, root_y = 0, win_x = 0, win_y = 0;
+    unsigned int mask = 0;
+    XQueryPointer(xdisplay, DefaultRootWindow(xdisplay), &root_ret, &child_ret, &root_x, &root_y, &win_x, &win_y, &mask);
+    *out_x = (double)x / scale;
+    *out_y = (double)y / scale;
+    *out_primary = (mask & Button1Mask) != 0;
+    *out_cursor_x = (double)root_x / scale;
+    *out_cursor_y = (double)root_y / scale;
+    return 1;
+#else
+    (void)host; (void)window_id; (void)dx; (void)dy; (void)clamp; (void)out_x; (void)out_y;
+    (void)out_hit_x; (void)out_hit_y; (void)out_primary; (void)out_cursor_x; (void)out_cursor_y;
+    return 0;
+#endif
+}
+
+int native_sdk_gtk_resize_window(native_sdk_gtk_host_t *host, uint64_t window_id, double width, double height, int bottom_center) {
+#if NATIVE_SDK_HAS_X11
+    native_sdk_gtk_window_t *win = native_sdk_find_window(host, window_id);
+    Display *xdisplay = NULL;
+    Window xid = None;
+    int scale = 1;
+    if (!native_sdk_x11_window(win, &xdisplay, &xid, &scale)) return 0;
+    int old_w = gtk_widget_get_width(GTK_WIDGET(win->gtk_window));
+    int old_h = gtk_widget_get_height(GTK_WIDGET(win->gtk_window));
+    int x = 0, y = 0;
+    native_sdk_x11_origin(xdisplay, xid, &x, &y);
+    int w = (int)(width + 0.5);
+    int h = (int)(height + 0.5);
+    if (w < 1 || h < 1) return 0;
+    /* A non-resizable GtkWindow ignores a new default size: lift the flag
+     * for the change, then restore it. */
+    gboolean resizable = gtk_window_get_resizable(win->gtk_window);
+    if (!resizable) gtk_window_set_resizable(win->gtk_window, TRUE);
+    gtk_window_set_default_size(win->gtk_window, w, h);
+    XResizeWindow(xdisplay, xid, (unsigned)(w * scale), (unsigned)(h * scale));
+    if (!resizable) gtk_window_set_resizable(win->gtk_window, FALSE);
+    if (bottom_center && old_w > 0 && old_h > 0) {
+        XMoveWindow(xdisplay, xid, x + ((old_w - w) * scale) / 2, y + (old_h - h) * scale);
+    }
+    XFlush(xdisplay);
+    return 1;
+#else
+    (void)host; (void)window_id; (void)width; (void)height; (void)bottom_center;
+    return 0;
+#endif
+}
