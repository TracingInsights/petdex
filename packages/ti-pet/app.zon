.{
    .id = "dev.tracinginsights.pet",
    .name = "ti-pet",
    .display_name = "TracingInsights Pet",
    .description = "TracingInsights desktop pet: Petdex's native renderer driven by the TracingInsights desktop app.",
    .version = "0.2.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{ "macos", "windows", "linux" },
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces", "menus", "tray" },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "TracingInsights Pet",
                .width = 152,
                .height = 164,
                .resizable = false,
                .titlebar = "chromeless",
                .floating = true,
                .fullscreen_overlay = true,
                .transparent = true,
                .restore_state = false,
                .restore_policy = "center_on_primary",
                .views = .{
                    .{ .label = "pet-canvas", .kind = "gpu_surface", .fill = true, .role = "Pet canvas", .accessibility_label = "TracingInsights pet", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "premultiplied", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
}
